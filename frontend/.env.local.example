# ── Frontend Environment Variables ────────────────────────────────────────────
# Copy this file to .env.local (git-ignored) and fill in your values.
# On Vercel, add these as Environment Variables in the project settings.

# Supabase project URL
# Found in: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://[project-ref].supabase.co

# Supabase anonymous (public) key — safe to expose in the browser
# Found in: Supabase Dashboard → Project Settings → API → Project API keys → anon/public
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API URL (your Render deployment)
VITE_API_URL=https://your-backend.onrender.com
